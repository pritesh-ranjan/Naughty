<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_new_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_note"
        android:shortcutShortLabel="@string/shortcut_new_note"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.naughty"
            android:targetClass="com.example.naughty.QuickNotePopupActivity">
            <extra
                android:name="action"
                android:value="quick_new_note" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_todo_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_todo"
        android:shortcutShortLabel="@string/shortcut_todo"
        android:shortcutLongLabel="@string/shortcut_todo_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.naughty"
            android:targetClass="com.example.naughty.QuickNotePopupActivity">
            <extra
                android:name="action"
                android:value="quick_todo_note" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_timeline_tasks"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_timeline"
        android:shortcutShortLabel="@string/shortcut_timeline"
        android:shortcutLongLabel="@string/shortcut_timeline_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.naughty"
            android:targetClass="com.example.naughty.MainActivity">
            <extra
                android:name="action"
                android:value="timeline_tasks" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
