# Keystore Configuration Template for Production Release Signing
# Copy this file to 'keystore.properties' (which is gitignored) and fill in your values.
#
# To generate a new production release keystore:
# keytool -genkeypair -v -keystore release.keystore -alias naughty -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Naughty FOSS, OU=Release, O=Naughty Open Source, L=Local, ST=State, C=US"
#
storeFile=../release.keystore
storePassword=your_keystore_password
keyAlias=naughty
keyPassword=your_key_password
